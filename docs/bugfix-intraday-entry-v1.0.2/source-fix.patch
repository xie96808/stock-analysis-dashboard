diff --git a/src/chart/intraday.test.ts b/src/chart/intraday.test.ts
new file mode 100644
index 0000000..1d68d4a
--- /dev/null
+++ b/src/chart/intraday.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from 'vitest'
+import { placeIntradayPrompt, supportsIntraday } from './intraday'
+
+describe('intraday entry policy', () => {
+  it('only enables entry from daily candles', () => {
+    expect(supportsIntraday('日K')).toBe(true)
+    for (const timeframe of ['1分', '5分', '15分', '30分', '60分', '周K', '月K']) {
+      expect(supportsIntraday(timeframe)).toBe(false)
+    }
+    expect(supportsIntraday('日K', '趋势线')).toBe(false)
+  })
+
+  it('keeps the confirmation prompt inside the chart', () => {
+    expect(placeIntradayPrompt({ x: 300, y: 200 }, { width: 900, height: 600 })).toEqual({ x: 312, y: 212 })
+    expect(placeIntradayPrompt({ x: 895, y: 595 }, { width: 900, height: 600 })).toEqual({ x: 666, y: 474 })
+    expect(placeIntradayPrompt({ x: -20, y: -20 }, { width: 900, height: 600 })).toEqual({ x: 10, y: 10 })
+  })
+})
diff --git a/src/chart/intraday.ts b/src/chart/intraday.ts
new file mode 100644
index 0000000..26a3a38
--- /dev/null
+++ b/src/chart/intraday.ts
@@ -0,0 +1,16 @@
+export type ChartPoint = { x: number; y: number }
+
+export function supportsIntraday(timeframe: string, activeTool = '选择') {
+  return timeframe === '日K' && activeTool === '选择'
+}
+
+export function placeIntradayPrompt(
+  point: ChartPoint,
+  host: { width: number; height: number },
+  prompt: { width: number; height: number } = { width: 224, height: 116 },
+) {
+  return {
+    x: Math.max(10, Math.min(point.x + 12, host.width - prompt.width - 10)),
+    y: Math.max(10, Math.min(point.y + 12, host.height - prompt.height - 10)),
+  }
+}
