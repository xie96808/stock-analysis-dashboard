{
  "name": "stock-analysis-dashboard",
  "private": true,
  "version": "1.0.2",
  "description": "TradingView-inspired local technical-analysis dashboard for China A-shares and Hong Kong stocks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "app": "bash ./start.sh",
    "dev": "vite --host 127.0.0.1",
    "backend": ".venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test:frontend": "vitest run",
    "test:backend": ".venv/bin/python -m pytest backend/tests -q",
    "index:build": ".venv/bin/python scripts/build-instrument-index.py",
    "check": "bash ./scripts/check.sh",
    "release:bundle": "bash ./scripts/package-release.sh"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
